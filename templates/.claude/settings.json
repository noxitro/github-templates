{
  "permissions": {
    "deny": [
      "Bash(git config *core.hooksPath*)",
      "Bash(git config *core.hookspath*)",
      "Bash(git config *nox.hooks*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_REMOTE:-}\" != true ] || bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.sh\""
          }
        ]
      }
    ]
  }
}

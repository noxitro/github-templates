#!/bin/sh
# コミットメッセージに外部資料の名前が入っていないか見る。
# メッセージは後から直すと履歴の書き換えになるので、書いた時点で止める。
set -u
DIR=$(dirname "$0")
. "$DIR/enabled.sh"
. "$DIR/chain.sh"
if nox_hooks_enabled; then
  PY=$(sh "$DIR/find-python.sh")
  if [ -z "$PY" ]; then
    echo "commit-msg: Python が見つからないので外部資料名の検査を飛ばした" >&2
  else
    "$PY" "$DIR/check-external-names.py" --message "$1" || exit 1
  fi
fi
nox_run_local_hook commit-msg "$@"
